# ============================================================
# MEV 夹子攻击预警 Bot 配置文件
# 复制为 .env 并填入实际值
# ============================================================

# ---------- 通知渠道（至少配置一个） ----------

# Telegram Bot 凭证（从 @BotFather 获取）
# 若网络屏蔽 api.telegram.org，需部署 telegram-proxy-worker.js 作为代理
TELEGRAM_BOT_TOKEN="你的Bot Token"
TELEGRAM_CHAT_ID="你的数字Chat ID"

# Telegram API 地址（默认官方，若网络屏蔽可填 Cloudflare Worker 代理地址）
# 部署 telegram-proxy-worker.js 到 Cloudflare Workers 后填入其 URL，例如：
# TELEGRAM_API_BASE="https://tg-proxy.your-name.workers.dev"
TELEGRAM_API_BASE="https://api.telegram.org"

# ntfy.sh 通知（免费、无需注册，推荐作为备选通知渠道）
# 1. 手机安装 ntfy App（iOS/Android）
# 2. 订阅一个自定义 topic 名称（下方 NTFY_TOPIC 的值）
# 3. Bot 检测到夹子攻击时会推送告警到该 topic
NTFY_TOPIC="mev-sandwich-alerts"
NTFY_SERVER="https://ntfy.sh"

# ---------- 区块链 RPC ----------

# 以太坊 RPC 节点（免费公共节点，可替换为 Alchemy/Infura/QuickNode）
RPC_URL="https://eth.drpc.org"

# 网络选择 (ethereum / bsc)
NETWORK="ethereum"

# 轮询间隔（秒）
POLL_INTERVAL=2

# 是否同时扫描 BSC (Pancakeswap)
SCAN_BSC=false
BSC_RPC_URL="https://bsc-dataseed.binance.org"

# ---------- 代理（可选，沙箱/受限网络环境需要） ----------
# 如果你的网络需要通过代理访问外网，取消注释并填入代理地址
# HTTP_PROXY="http://127.0.0.1:18080"
# HTTPS_PROXY="http://127.0.0.1:18080"
