# ============================================================
# MEV Sandwich Attack Alert Bot configuration file
# Copy to .env and fill in real values
# ============================================================

# ---------- Notification channels (configure at least one) ----------

# Telegram Bot credentials (obtain from @BotFather)
# If the network blocks api.telegram.org, deploy telegram-proxy-worker.js as a proxy
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_numeric_chat_id"

# Telegram API base URL (official by default; if blocked, set to your Cloudflare Worker proxy URL)
# After deploying telegram-proxy-worker.js to Cloudflare Workers, set its URL here, e.g.:
# TELEGRAM_API_BASE="https://tg-proxy.your-name.workers.dev"
TELEGRAM_API_BASE="https://api.telegram.org"

# ntfy.sh notifications (free, no registration required; recommended as a fallback channel)
# 1. Install the ntfy app on your phone (iOS/Android)
# 2. Subscribe to a custom topic name (the value of NTFY_TOPIC below)
# 3. The bot will push alerts to that topic when a sandwich attack is detected
NTFY_TOPIC="mev-sandwich-alerts"
NTFY_SERVER="https://ntfy.sh"

# ---------- Blockchain RPC ----------

# Ethereum RPC node (free public node; can be replaced with Alchemy/Infura/QuickNode)
RPC_URL="https://eth.drpc.org"

# Network selection (ethereum / bsc)
NETWORK="ethereum"

# Polling interval (seconds)
POLL_INTERVAL=2

# Whether to also scan BSC (Pancakeswap)
SCAN_BSC=false
BSC_RPC_URL="https://bsc-dataseed.binance.org"

# ---------- Proxy (optional; required in sandbox/restricted networks) ----------
# If your network requires a proxy to access the internet, uncomment and set the proxy URL
# HTTP_PROXY="http://127.0.0.1:18080"
# HTTPS_PROXY="http://127.0.0.1:18080"
